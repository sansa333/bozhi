# OpenAI-compatible service; copy values from your own local configuration.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=12000
LLM_ATTEMPTS=2
LLM_DISABLE_THINKING=true
# remote is the exam-required mode; local is a clearly marked review-only preview.
OCR_MODE=remote
OCR_ENDPOINT=https://gateway.pltplt.com/ai/process
OCR_API_KEY=
OCR_ATTEMPTS=2
# Optional file-only HTTPS service; shared secret must be at least 32 random characters.
# Or use `shipping-agent serve --ocr-tunnel` with an explicitly installed cloudflared binary.
OCR_FILE_BASE_URL=
OCR_FILE_SECRET=
OCR_FILE_TTL_SECONDS=900
CLOUDFLARED_PATH=
LIBREOFFICE_PATH=
# Optional policy: linked_signed_adjustment requires a unique, evidence-backed original invoice.
CREDIT_NOTE_POLICY=review
ACCOUNTING_ENTITY=
# Optional aliases for this same legal entity. Do not list trading partners here.
ACCOUNTING_ALIASES=[]
DATA_DIR=data/private
MAX_FILE_BYTES=20971520
MAX_BATCH_BYTES=104857600
MAX_DOCUMENTS=100
MAX_DEPTH=4
MAX_PAGES=30
MAX_TEXT_CHARS=90000
API_TOKEN=
