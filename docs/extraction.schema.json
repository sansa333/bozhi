    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Field path, e.g. charge_details.amount or transaction_party.payer",
          "title": "Path",
          "type": "string"
        },
        "quote": {
          "description": "Exact verbatim substring of the source text",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "path",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExtractedLine": {
      "additionalProperties": false,
      "properties": {
        "source_line": {
          "description": "Position in source, e.g. page 1 row 2; preserve distinct rows",
          "title": "Source Line",
          "type": "string"
        },
        "charge_details": {
          "$ref": "#/$defs/Charge"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explicit_changes": {
          "description": "Paths explicitly instructed to change",
          "items": {
            "type": "string"
          },
          "title": "Explicit Changes",
          "type": "array"
        },
        "change_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim instruction authorizing changes",
          "title": "Change Quote"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source_line",
        "charge_details",
        "evidence",
        "confidence"
      ],
      "title": "ExtractedLine",
      "type": "object"
    },
